# Copy to your hosting provider's variables. Never commit real values.
OPENAI_API_KEY=
NOVA_USERNAME=fabian
NOVA_PASSWORD=
NOVA_TIME_ZONE=Europe/Warsaw
# JDBC form, e.g. jdbc:postgresql://host:5432/nova
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
# Optional
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
NOVA_MAX_SESSION_MINUTES=20
NOVA_MAX_STARTS_PER_HOUR=30

# Retention (days)
NOVA_TRANSCRIPT_RETENTION_DAYS=30
NOVA_DIAGNOSTICS_RETENTION_DAYS=7
